# AUBS v2.0 config
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_ONLY=0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Retrieval / ingestion knobs
AUBS_TOP_K=7
AUBS_MIN_SCORE=0.18
AUBS_CHUNK_SIZE=512
AUBS_CHUNK_OVERLAP=64
AUBS_MEMORY_TURNS=4
AUBS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional password-protect UI if exposed beyond Tailscale
# GRADIO_AUTH=chris:change_this_password
